<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Premium SplashScreen API starting theme (Android 5.0 to 15) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.otium</item>
    </style>

    <!-- Base application theme with warm paper background matching default web theme -->
    <style name="Theme.otium" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:colorBackground">@color/splash_bg</item>
    </style>
</resources>
