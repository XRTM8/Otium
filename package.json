{
  "name": "otium-reader",
  "private": true,
  "version": "2.0.6",
  "type": "module",
  "scripts": {
    "lab:media": "vite --config experiments/media-lab/vite.config.ts",
    "lab:media:build": "tsc -p experiments/media-lab/tsconfig.json && vite build --config experiments/media-lab/vite.config.ts",
    "lab:media:test": "vitest run --config experiments/media-lab/vitest.config.ts",
    "dev": "vite",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "lint": "oxlint --deny-warnings src scripts experiments/media-lab",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview",
    "version:check": "node scripts/check-version.mjs",
    "e2e:verify": "node scripts/e2e-verify.mjs",
    "verify:apk": "node scripts/verify-apk.mjs",
    "release:feed": "node scripts/generate-latest-json.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android": "tauri android build --apk",
    "tauri:android:split": "tauri android build --apk --split-per-abi"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/almarai": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.61.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.88.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
